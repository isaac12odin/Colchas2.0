# En desarrollo use la IP local. Toda compilación de producción exige HTTPS.
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# En un teléfono físico, localhost es el teléfono. Use la IP LAN de su equipo:
# EXPO_PUBLIC_API_URL=http://192.168.1.20:4000/api/v1
# Los perfiles preview/production de eas.json ya apuntan al dominio HTTPS.
