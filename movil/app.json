{
  "expo": {
    "name": "Nexo Cobranza",
    "slug": "nexo-cobranza",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "nexo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nexo.cobranza",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Protege el acceso a datos de cobranza."
      }
    },
    "android": {
      "package": "com.nexo.cobranza",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#0f62fe"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
