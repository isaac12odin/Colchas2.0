{
  "expo": {
    "name": "Vektra",
    "slug": "vektra",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "vektra",
    "icon": "./assets/vektra-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nexo.cobranza",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Protege el acceso a datos de cobranza."
      }
    },
    "android": {
      "package": "com.nexo.cobranza",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/vektra-icon-foreground.png",
        "backgroundColor": "#f5f8fc"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Vektra usa tus fotos únicamente para identificar productos del inventario.",
          "cameraPermission": "Vektra usa la cámara para fotografiar productos y leer códigos QR o de barras.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Vektra usa la cámara para fotografiar productos y leer códigos QR o de barras.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
