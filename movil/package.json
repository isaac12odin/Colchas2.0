{
  "name": "@nexo/movil",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "NODE_PATH=./node_modules expo start",
    "android": "NODE_PATH=./node_modules expo run:android",
    "ios": "NODE_PATH=./node_modules expo run:ios",
    "build:android:preview": "npx eas-cli build --platform android --profile preview",
    "build:android": "npx eas-cli build --platform android --profile production",
    "build:ios": "npx eas-cli build --platform ios --profile production",
    "build:sqlcipher:ios": "npx eas-cli build --platform ios --profile integration",
    "build:sqlcipher:android": "npx eas-cli build --platform android --profile integration",
    "test": "vitest run",
    "test:sqlcipher": "maestro test .maestro/sqlcipher.yaml",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "expo": "~57.0.18",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.16",
    "expo-crypto": "~57.0.2",
    "expo-font": "~57.0.2",
    "expo-image-manipulator": "~57.0.14",
    "expo-image-picker": "~57.0.14",
    "expo-linking": "~57.0.8",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "typescript": "~6.0.3",
    "vitest": "3.2.7"
  }
}
