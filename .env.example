# Copie este archivo como .env en la raiz. Nunca use estos secretos en produccion.
DATABASE_URL="postgresql://nexo:nexo_local_seguro@127.0.0.1:55433/nexo_cobranza?schema=public"
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
JWT_ACCESS_SECRET=cambie-este-secreto-access-de-al-menos-32-caracteres
JWT_REFRESH_SECRET=cambie-este-secreto-refresh-de-al-menos-32-caracteres
# Clave base64 de 32 bytes. Genere con: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Obligatorios para `npm run db:seed`. No copie una contraseña de ejemplo:
# genere una temporal única, de 16+ caracteres, y entréguela por canal seguro.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
NEXT_PUBLIC_API_URL=/api
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
