NODE_ENV=production
PORT=4000
DOMINIO=nexo.ejemplo.com
FRONTEND_URL=https://nexo.ejemplo.com
# PostgreSQL debe estar en una red privada y en un servidor/servicio separado.
DATABASE_URL=postgresql://usuario:CLAVE@postgres-privado:5432/nexo_cobranza?schema=public&sslmode=require
JWT_ACCESS_SECRET=GENERE_UN_SECRETO_ALEATORIO_DE_64_BYTES
JWT_REFRESH_SECRET=GENERE_OTRO_SECRETO_ALEATORIO_DE_64_BYTES
FIELD_ENCRYPTION_KEY=GENERE_CON_OPENSSL_RAND_BASE64_32
# Obligatorios únicamente durante el seed inicial; retírelos después.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
BACKUP_DIR=/respaldos
BACKUP_ENCRYPTION_KEY=GENERE_UNA_FRASE_LARGA_Y_GUARDELA_FUERA_DEL_SERVIDOR
