[Unit]
Description=Nexo - respaldo cifrado, verificación y copia externa
After=docker.service postgresql.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/var/www/Colchas2.0
EnvironmentFile=/etc/nexo/nexo.env
Environment=ALLOW_LOCAL_BACKUP_ONLY=SI
ExecStart=/usr/bin/env BACKUP_DIR=/respaldos IMAGE_STORAGE_DIR=/var/lib/docker/volumes/nexo_uploads/_data /bin/sh /var/www/Colchas2.0/scripts/respaldo-postgres.sh
ExecStartPost=/usr/bin/env BACKUP_DIR=/respaldos /var/www/Colchas2.0/scripts/copiar-respaldo-externo.sh
User=root
Nice=10
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/respaldos
ReadOnlyPaths=/var/lib/docker/volumes/nexo_uploads/_data
NoNewPrivileges=true
