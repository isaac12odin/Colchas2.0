{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "formatter": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "correctness": {
        "noUnreachable": "error",
        "noUnusedImports": "error"
      },
      "suspicious": {
        "noDebugger": "error",
        "noDuplicateObjectKeys": "error"
      }
    }
  },
  "javascript": { "formatter": { "enabled": false } },
  "css": { "parser": { "tailwindDirectives": true } }
}
