{
  "name": "@nexo/back",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/servidor.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/src/servidor.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:robustas": "tsx scripts/preparar-base-pruebas.ts",
    "test:robustas": "E2E_CONFIRM_DATABASE=SI vitest run --config vitest.e2e.config.ts",
    "test:rutas:e2e": "tsx scripts/validar-rutas-e2e.ts",
    "test:empresarial:e2e": "tsx scripts/validar-operacion-empresarial.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:migrar-imagenes": "tsx prisma/migrar-imagenes-a-archivos.ts",
    "db:migrar-imagenes:prod": "node dist/prisma/migrar-imagenes-a-archivos.js",
    "db:seed": "tsx prisma/seed.ts",
    "db:reindexar-telefonos": "tsx prisma/reindexar-telefonos.ts",
    "reconciliar": "tsx scripts/reconciliar-proyecciones.ts",
    "db:demo": "tsx prisma/demo.ts",
    "db:demo:limpiar": "tsx prisma/demo-limpiar.ts",
    "db:carga-volumen": "tsx prisma/carga-volumen.ts",
    "db:carga-volumen:limpiar": "tsx prisma/carga-volumen.ts --limpiar",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.8.2",
    "argon2": "0.41.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "date-fns": "4.1.0",
    "dotenv": "16.5.0",
    "exceljs": "3.10.0",
    "express": "5.1.0",
    "express-rate-limit": "7.5.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "pdfkit": "0.16.0",
    "pino": "9.7.0",
    "pino-http": "10.4.0",
    "sharp": "0.35.3",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.18",
    "@types/express": "5.0.1",
    "@types/jsonwebtoken": "9.0.9",
    "@types/node": "22.15.17",
    "@types/pdfkit": "0.13.8",
    "@types/supertest": "^6.0.3",
    "prisma": "6.8.2",
    "supertest": "7.1.3",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "3.2.7"
  }
}
